{
  "name": "petal",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "backend": "pnpm --filter backend dev",
    "frontend": "pnpm --filter frontend dev",
    "db:up": "docker compose -f backend/docker-compose.yml up -d",
    "db:down": "docker compose -f backend/docker-compose.yml down",
    "db:logs": "docker compose -f backend/docker-compose.yml logs -f postgres",
    "s3:logs": "docker compose -f backend/docker-compose.yml logs -f localstack",
    "s3:setup": "bash backend/scripts/localstack/setup-s3.sh",
    "format": "pnpm --filter backend format && pnpm --filter frontend format",
    "lint": "pnpm --filter backend lint && pnpm --filter frontend lint"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["@nestjs/core", "sharp", "unrs-resolver"]
  }
}
