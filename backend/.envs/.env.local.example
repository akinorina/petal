# backend/.envs/.env.local.example
# ローカル開発環境用の環境変数テンプレート。
# このファイルをコピーして .env.local を作成し、実際の値を埋めてください。
#   cp .env.local.example .env.local
# その後、環境切り替えスクリプトで symlink を作成します。
#   bash scripts/use-env.sh local

# =============================================================================
# Database
# =============================================================================

# ローカル PostgreSQL（Docker）
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=petal

# =============================================================================
# AWS Cognito
# =============================================================================

COGNITO_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# クライアントシークレット（Confidential client 必須）
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Auth
# =============================================================================

SKIP_AUTH=false
# SKIP_AUTH=true 時に request.user に紐付けるダミーユーザーの DB id（任意）。
# 未指定時は cognito_sub='test-user' のレコードを引く。
SKIP_AUTH_USER_ID=

# ログイン失敗のロックアウト（任意・未指定時は既定値で動作）。
# 同一 email で連続 N 回失敗するとロックし、/auth/login が 429 を返す。
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MINUTES=15

# セルフユーザー登録（サインアップ）の可否。
# 'true' のときのみ有効。未指定/その他は無効（デフォルト OFF）。
# 無効時は /auth/signup・/auth/confirm-signup が 403 を返し、フロントの登録導線も非表示になる。
SELF_SIGNUP_ENABLED=false

# =============================================================================
# CORS
# =============================================================================

# API の CORS 許可オリジン（カンマ区切りで複数指定可）
# LAN端末からアクセスする場合は該当IPを追加する
CORS_ORIGINS=https://localhost:3001
# LocalStack S3 CORS の許可オリジン（カンマ区切りで複数指定可）
# LAN端末からアクセスする場合は該当IPを追加する
FRONTEND_ORIGINS=https://localhost:3001

# =============================================================================
# AWS S3（画像ストレージ）
# =============================================================================

AWS_REGION=ap-northeast-1
S3_BUCKET=petal-images
# Local 環境では Localstack を使う。本番では空 + S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://192.168.11.9:4566
S3_FORCE_PATH_STYLE=true
# LAN端末からアクセスする場合、署名付きURLのホストをこちらに書き換える（開発時のみ）
# フロントが HTTPS のため、mixed content を避けるべく https を指定すること。
# LocalStack には mkcert 証明書をマウントして HTTPS を提供する
# （scripts/localstack/generate-localstack-cert.sh で生成。docker-compose.yml 参照）
# 例: S3_PUBLIC_ENDPOINT=https://192.168.11.9:4566
S3_PUBLIC_ENDPOINT=https://192.168.11.9:4566

# AWS 認証情報（本番デプロイ環境用。ローカルは IAM ロールまたは AWS CLI プロファイルで代替可）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# =============================================================================
# create-admin スクリプト用（実行時のみ設定）
# =============================================================================

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=管理者
ADMIN_NAME_KANA=かんりしゃ

# =============================================================================
# LLM チャット（chat フィーチャ / OpenAI 互換エンドポイント）
# =============================================================================

# 接続先 OpenAI 互換エンドポイント（必須・URL）。例: LM Studio をローカル起動した場合
LLM_BASE_URL=http://localhost:1234/v1
# API キー（任意）。未設定時は SDK 用に 'not-needed' が既定値となる（LM Studio 等は無視）
LLM_API_KEY=
# 既定モデル（任意）。入力 model も LLM_MODEL も無いと生成時にエラーになる
LLM_MODEL=
