# backend/.envs/.env.local.example
# ローカル開発環境用の環境変数テンプレート。
# このファイルをコピーして .env.local を作成し、実際の値を埋めてください。
#   cp .env.local.example .env.local
# その後、環境切り替えスクリプトで symlink を作成します。
#   bash scripts/use-env.sh local

# =============================================================================
# Database
# =============================================================================

# ローカル PostgreSQL（Docker）
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=petal

# Supabase 接続文字列（ローカルでは未使用。本番環境用テンプレートとして記載）
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# =============================================================================
# AWS Cognito
# =============================================================================

COGNITO_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Auth
# =============================================================================

SKIP_AUTH=false
SKIP_AUTH_USER_ID=

# =============================================================================
# CORS
# =============================================================================

CORS_ORIGIN=http://localhost:3001

# =============================================================================
# AWS S3（画像ストレージ）
# =============================================================================

AWS_REGION=ap-northeast-1
S3_BUCKET=petal-images
# Local 環境では Localstack を使う。本番では空 + S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# =============================================================================
# create-admin スクリプト用（実行時のみ設定）
# =============================================================================

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=管理者
ADMIN_NAME_KANA=カンリシャ
