#
# .env for PROD
#

# backend/.envs/.env.prod.example
# 本番環境（prod）用の環境変数テンプレート。
# このファイルをコピーして .env.prod を作成し、実際の値を埋めてください。
#   cp .env.prod.example .env.prod
#
# Lambda（prod ステージ）へのデプロイ時は以下を実行してください。
#   pnpm run deploy:prod

# =============================================================================
# Stage
# =============================================================================

STAGE=prod

# =============================================================================
# Database（Neon DB）
# =============================================================================

# Neon DB 接続文字列（PgBouncer Pooler 経由）
DATABASE_URL='postgresql://[user]:[password]@[host]-pooler.[region].aws.neon.tech/petal?sslmode=require&channel_binding=require'
# Direct 接続（マイグレーション実行専用）
DATABASE_URL_DIRECT='postgresql://[user]:[password]@[host].[region].aws.neon.tech/petal?sslmode=require&channel_binding=require'

# =============================================================================
# AWS Cognito（開発環境用 User Pool: petal-prod）
# =============================================================================

COGNITO_REGION=ap-northeast-1
# Cognito Console → User Pool 詳細画面から取得
COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
# Cognito Console → App Client 詳細画面から取得
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Cognito Console → App Client → クライアントシークレットを表示 から取得
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Auth
# =============================================================================

SKIP_AUTH=false
SKIP_AUTH_USER_ID=

# ログイン失敗のロックアウト（任意・未指定時は既定値 5 回 / 15 分で動作）。
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MINUTES=15

# セルフユーザー登録（サインアップ）の可否。
# 'true' のときのみ有効。未指定/その他は無効（デフォルト OFF）。
# 無効時は /auth/signup・/auth/confirm-signup が 403 を返し、フロントの登録導線も非表示になる。
SELF_SIGNUP_ENABLED=false

# =============================================================================
# CORS
# =============================================================================

# Amplify prod URL（Amplify Console で確認）
CORS_ORIGINS=https://main.xxxxxxxxxx.amplifyapp.com

# =============================================================================
# AWS S3（画像ストレージ）
# =============================================================================

AWS_REGION=ap-northeast-1

# 開発環境用 S3 バケット名（TSK-39 で作成）
S3_BUCKET=petal-images-prod

# =============================================================================
# create-admin スクリプト用（実行時のみ設定）
# =============================================================================

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=管理者
ADMIN_NAME_KANA=カンリシャ

# =============================================================================
# LLM チャット（chat フィーチャ / OpenAI 互換エンドポイント）
# =============================================================================

# 接続先 OpenAI 互換エンドポイント（必須・URL）
LLM_BASE_URL=
# API キー（任意）。未設定時は SDK 用に 'not-needed' が既定値となる
LLM_API_KEY=
# 既定モデル（任意）。入力 model も LLM_MODEL も無いと生成時にエラーになる
LLM_MODEL=
