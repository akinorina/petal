# backend/.envs/.env.staging.example
# ステージング環境用の環境変数テンプレート。
# このファイルをコピーして .env.staging を作成し、実際の値を埋めてください。
#   cp .env.staging.example .env.staging
# その後、環境切り替えスクリプトで symlink を作成します。
#   bash scripts/use-env.sh staging

# Database
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=petal

# AWS Cognito
COGNITO_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# Auth
SKIP_AUTH=false
SKIP_AUTH_USER_ID=

# CORS
CORS_ORIGIN=https://staging.example.com

# AWS S3（画像ストレージ）
AWS_REGION=ap-northeast-1
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
