  "info": {
    "title": "Petal API",
    "description": "Petal 画像コンテンツ管理 API",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Cognito アクセストークン"
      }
    },
    "schemas": {
      "UserRole": {
        "type": "string",
        "enum": [
          "admin",
          "user"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserRole"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deletedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "id": {
            "type": "string"
          },
          "cognitoSub": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "nameKana": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "createdAt",
          "updatedAt",
          "deletedAt",
          "id",
          "cognitoSub",
          "email",
          "name",
          "nameKana"
        ]
      },
      "RequestEmailChangeRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "ConfirmEmailChangeRequestDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "CreateUserRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserRole"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "nameKana": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "name",
          "nameKana"
        ]
      },
      "UpdateUserRequestDto": {
        "type": "object",
        "properties": {
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserRole"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "nameKana": {
            "type": "string"
          }
        }
      },
      "AuthenticatedResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "AUTHENTICATED"
            ]
          },
          "accessToken": {
            "type": "string"
          },
          "idToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "accessToken",
          "idToken",
          "refreshToken",
          "expiresIn",
          "email"
        ]
      },
      "ChallengeResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "CHALLENGE"
            ]
          },
          "challengeName": {
            "type": "string",
            "enum": [
              "NEW_PASSWORD_REQUIRED"
            ]
          },
          "session": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "challengeName",
          "session",
          "email"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ForgotPasswordRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "ConfirmForgotPasswordRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "code": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "code",
          "newPassword"
        ]
      },
      "RefreshRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "refreshToken"
        ]
      },
      "RefreshResponseDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "accessToken": {
            "type": "string"
          },
          "idToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number"
          }
        },
        "required": [
          "email",
          "accessToken",
          "idToken",
          "expiresIn"
        ]
      },
      "NewPasswordChallengeRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "newPassword": {
            "type": "string"
          },
          "session": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "newPassword",
          "session"
        ]
      },
      "CreateImageRequestDto": {
        "type": "object",
        "properties": {
          "mimeType": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/gif",
              "image/webp"
            ]
          },
          "originalFilename": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "mimeType",
          "originalFilename",
          "sizeBytes"
        ]
      },
      "ImageResponseDto": {
        "type": "object",
        "properties": {
          "mimeType": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/gif",
              "image/webp"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string"
          },
          "ownerUserId": {
            "type": "string"
          },
          "originalFilename": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "number"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "mimeType",
          "createdAt",
          "updatedAt",
          "id",
          "ownerUserId",
          "originalFilename",
          "sizeBytes",
          "title",
          "description"
        ]
      },
      "UploadInstructionHeadersDto": {
        "type": "object",
        "properties": {
          "Content-Type": {
            "type": "string"
          }
        },
        "required": [
          "Content-Type"
        ]
      },
      "UploadInstructionDto": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "PUT"
            ]
          },
          "url": {
            "type": "string"
          },
          "expiresInSeconds": {
            "type": "number"
          },
          "headers": {
            "$ref": "#/components/schemas/UploadInstructionHeadersDto"
          }
        },
        "required": [
          "method",
          "url",
          "expiresInSeconds",
          "headers"
        ]
      },
      "CreateImageResponseDto": {
        "type": "object",
        "properties": {
          "image": {
            "$ref": "#/components/schemas/ImageResponseDto"
          },
          "upload": {
            "$ref": "#/components/schemas/UploadInstructionDto"
          }
        },
        "required": [
          "image",
          "upload"
        ]
      },
      "DownloadUrlResponseDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "expiresInSeconds": {
            "type": "number"
          }
        },
        "required": [
          "url",
          "expiresInSeconds"
        ]
      }
    }
  }
}
