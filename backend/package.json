{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "HTTPS=true nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test,scripts}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:logs": "docker compose -f ./docker-compose.yml logs -f postgres",
    "migration:run": "typeorm-ts-node-commonjs -d database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d database/data-source.ts migration:revert",
    "migration:generate": "typeorm-ts-node-commonjs -d database/data-source.ts migration:generate",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:show": "typeorm-ts-node-commonjs -d database/data-source.ts migration:show",
    "create-admin": "ts-node -r tsconfig-paths/register scripts/create-admin.ts",
    "audit-cognito-sync": "ts-node -r tsconfig-paths/register scripts/audit-cognito-sync.ts",
    "import-cognito-users": "ts-node -r tsconfig-paths/register scripts/import-cognito-users.ts",
    "openapi:export": "nest build && node dist/src/openapi-export.js",
    "use-env": "bash scripts/use-env.sh",
    "s3:logs": "docker compose -f ./docker-compose.yml logs -f localstack",
    "s3:setup": "bash ./scripts/localstack/setup-s3.sh",
    "bundle:lambda": "esbuild dist/src/lambda.js --bundle --platform=node --target=node22 --outfile=lambda.js --external:@aws-sdk/* --external:pg-native --external:class-transformer --external:class-validator --external:@nestjs/websockets --external:@nestjs/websockets/socket-module --external:@nestjs/microservices --external:@nestjs/microservices/microservices-module --external:cache-manager --keep-names",
    "deploy": "nest build && pnpm run bundle:lambda && AWS_PROFILE=petal-deploy serverless deploy --region ap-northeast-1",
    "deploy:dev": "set -a && . ./.envs/.env.dev && set +a && nest build && pnpm run bundle:lambda && AWS_PROFILE=petal-deploy serverless deploy --region ap-northeast-1",
    "deploy:function": "nest build && pnpm run bundle:lambda && AWS_PROFILE=petal-deploy serverless deploy function --function backend --region ap-northeast-1",
    "deploy:function:dev": "set -a && . ./.envs/.env.dev && set +a && nest build && pnpm run bundle:lambda && AWS_PROFILE=petal-deploy serverless deploy function --function backend --region ap-northeast-1",
    "deploy:remove": "AWS_PROFILE=petal-deploy serverless remove --region ap-northeast-1",
    "deploy:remove:dev": "set -a && . ./.envs/.env.dev && set +a && AWS_PROFILE=petal-deploy serverless remove --region ap-northeast-1"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1041.0",
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/typeorm": "^11.0.1",
    "@vendia/serverless-express": "^4.12.6",
    "aws-jwt-verify": "^5.1.1",
    "dotenv": "^17.4.2",
    "openai": "^6.42.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/aws-lambda": "^8.10.161",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "serverless": "^4.35.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "roots": [
      "<rootDir>",
      "<rootDir>/../scripts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
