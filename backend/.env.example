# =============================================================================
# Database
# =============================================================================

# ローカル開発用 PostgreSQL（Docker / Localstack）
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=petal

# 本番（Supabase）用接続文字列
# DATABASE_URL     : PgBouncer Pooler 経由（port 6543）。通常の API 実行時に使用。
# DATABASE_URL_DIRECT : Direct 接続（port 5432）。マイグレーション実行専用。
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# =============================================================================
# AWS Cognito
# =============================================================================

COGNITO_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# クライアントシークレット（Confidential client 必須）
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Auth
# =============================================================================

SKIP_AUTH=false
# SKIP_AUTH=true 時に request.user に紐付けるダミーユーザーの DB id（任意）。
# 未指定時は cognito_sub='test-user' のレコードを引く。
SKIP_AUTH_USER_ID=

# =============================================================================
# CORS
# =============================================================================

CORS_ORIGIN=http://localhost:3001

# =============================================================================
# AWS S3（画像ストレージ）
# =============================================================================

AWS_REGION=ap-northeast-1
S3_BUCKET=petal-images
# ローカル環境では Localstack を使う。本番では空にして S3_FORCE_PATH_STYLE=false にする。
S3_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true

# AWS 認証情報（本番デプロイ環境用。ローカルは IAM ロールまたは AWS CLI プロファイルで代替可）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# =============================================================================
# create-admin スクリプト用（実行時のみ設定）
# =============================================================================

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=管理者
ADMIN_NAME_KANA=カンリシャ
