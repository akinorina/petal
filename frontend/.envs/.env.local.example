# frontend/.envs/.env.local.example
# ローカル開発環境用の環境変数テンプレート。
# このファイルをコピーして .env.local を作成し、実際の値を埋めてください。
#   cp .env.local.example .env.local
# その後、環境切り替えスクリプトで symlink を作成します。
#   bash scripts/use-env.sh local

# =============================================================================
# Backend API
# =============================================================================

# バックエンド API のベース URL
# ローカル: http://localhost:3000
# 本番: https://api.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# =============================================================================
# AWS Cognito
# =============================================================================

# Cognito リージョン
NEXT_PUBLIC_COGNITO_REGION=ap-northeast-1
# Cognito User Pool ID
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
# Cognito アプリクライアント ID（公開情報。シークレットはここに含めない）
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
