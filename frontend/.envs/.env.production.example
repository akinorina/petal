# frontend/.envs/.env.production.example
# 本番環境用の環境変数テンプレート。
# 実際の値は AWS Amplify Console の「環境変数」画面で設定する。
# このファイル自体には実際の値を記載しない。

# =============================================================================
# Backend API
# =============================================================================

# API Gateway の URL（TSK-36 の serverless deploy 後に取得）
NEXT_PUBLIC_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com

# =============================================================================
# AWS Cognito
# =============================================================================

# Cognito リージョン
NEXT_PUBLIC_COGNITO_REGION=ap-northeast-1
# 本番用 Cognito User Pool ID（TSK-38 で作成）
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
# 本番用 Cognito アプリクライアント ID（TSK-38 で作成）
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
