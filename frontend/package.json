{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "start:dev": "next dev --experimental-https --experimental-https-key ../certs/localhost+2-key.pem --experimental-https-cert ../certs/localhost+2.pem",
    "start:dev:clean": "rm -rf .next && pnpm start:dev",
    "clean": "rm -rf .next",
    "start:prod": "next start",
    "build": "next build && serwist build serwist.config.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "openapi:gen": "openapi-typescript ../backend/openapi.json -o src/lib/openapi/schema.d.ts",
    "design-system:sync": "DS_PATH=../../design-system DS_TARGET=src/design-system bash scripts/sync-design-system.sh all",
    "use-env": "bash scripts/use-env.sh"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@serwist/next": "^9.5.11",
    "next": "16.2.4",
    "openapi-fetch": "^0.17.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@lhci/cli": "0.13.0",
    "@serwist/cli": "^9.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "serwist": "^9.5.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
